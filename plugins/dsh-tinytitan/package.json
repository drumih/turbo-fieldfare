{
  "name": "dsh-tinytitan",
  "version": "0.2.2-rc.1",
  "description": "DeepSeek Harness route and quiet compaction for a local TinyTitan server",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./backend": "./src/backend.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pummelchen/TinyTitan.git",
    "directory": "plugins/dsh-tinytitan"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-include": "~1.1.0",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.1",
    "js-yaml": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-include": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-app": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "tinytitan",
    "qwen",
    "local"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "~1.1.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "js-yaml": "^4.3.2",
    "prettier": "3.9.9"
  },
  "overrides": {
    "minimatch": "11.0.7"
  }
}
